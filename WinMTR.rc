IDD_DIALOG_HELP DIALOGEX 0, 0, 330, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WinMTR"
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
