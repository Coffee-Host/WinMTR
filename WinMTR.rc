IDD_DIALOG_HELP DIALOGEX 0, 0, 330, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WinMTR"
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "確定",IDOK,140,127,50,16
    LTEXT           "WinMTR v1.00－路由與延遲診斷工具",IDC_STATIC,12,10,200,10
    LTEXT           "用法：WinMTR [選項] 目標主機",IDC_STATIC,12,29,190,9
    LTEXT           "--interval, -i 秒數     設定探測間隔",IDC_STATIC,26,48,190,9
    LTEXT           "--size, -s 位元組       設定探測資料大小",IDC_STATIC,26,61,190,9
    LTEXT           "--maxLRU, -m 數量       設定歷程主機上限",IDC_STATIC,26,74,190,9
    LTEXT           "--numeric, -n           不解析主機名稱",IDC_STATIC,26,87,190,9
    LTEXT           "--help, -h              顯示本說明",IDC_STATIC,26,100,190,9
END

