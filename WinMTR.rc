    COMBOBOX        IDC_COMBO_HOST,31,10,122,80,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "開始(&T)",ID_RESTART,159,9,36,15,BS_FLAT
    PUSHBUTTON      "選項(&O)",ID_OPTIONS,201,9,36,15,BS_FLAT
    PUSHBUTTON      "重設統計(&R)",ID_RESET_STATS,243,9,52,15,BS_FLAT
    PUSHBUTTON      "截圖至剪貼簿(&S)",ID_CAPTURE_SCREENSHOT,301,9,56,15,BS_FLAT
    PUSHBUTTON      "複製／匯出",ID_REPORT_MENU,363,9,52,15,BS_FLAT
    LTEXT           "",IDC_PUBLIC_IP_TEXT,10,36,111,8,SS_CENTERIMAGE
    LTEXT           "",IDC_PUBLIC_HOSTNAME_TEXT,10,48,111,8,SS_CENTERIMAGE
    LTEXT           "",IDC_PUBLIC_COUNTRY_TEXT,129,36,69,8,SS_CENTERIMAGE | SS_ENDELLIPSIS
    LTEXT           "",IDC_PUBLIC_CITY_TEXT,129,48,69,8,SS_CENTERIMAGE | SS_ENDELLIPSIS
    LTEXT           "",IDC_PUBLIC_ASN_TEXT,206,36,185,8,SS_CENTERIMAGE | SS_ENDELLIPSIS
    LTEXT           "",IDC_PUBLIC_ISP_TEXT,206,48,185,8,SS_CENTERIMAGE | SS_ENDELLIPSIS
    PUSHBUTTON      "",ID_NETWORK_DETAILS,399,39,41,15,BS_FLAT
    CONTROL         "",IDC_LIST_MTR,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,5,66,440,145
    GROUPBOX        "",IDC_STATICS,5,2,194,25,BS_FLAT
    GROUPBOX        "",IDC_STATIC_ACTIONS,201,2,244,25,BS_FLAT
    GROUPBOX        "",IDC_STATICJ,5,29,440,30,BS_FLAT
END

IDD_DIALOG_OPTIONS DIALOGEX 0, 0, 360, 240
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "追蹤選項"
FONT 9, "Microsoft JhengHei UI", 0, 0, 0x0
BEGIN
    GROUPBOX        "探測設定",IDC_STATIC,8,7,344,145
    LTEXT           "間隔（秒）：",IDC_STATIC,18,24,58,10
    EDITTEXT        IDC_EDIT_INTERVAL,82,21,42,14,ES_AUTOHSCROLL
    LTEXT           "封包資料（位元組）：",IDC_STATIC,183,24,82,10
    EDITTEXT        IDC_EDIT_SIZE,274,21,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "最大跳數：",IDC_STATIC,18,48,58,10
    EDITTEXT        IDC_EDIT_MAX_HOPS,82,45,42,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "逾時（毫秒）：",IDC_STATIC,183,48,72,10
    EDITTEXT        IDC_EDIT_TIMEOUT,274,45,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "循環次數（0 為不限）：",IDC_STATIC,18,72,94,10
    EDITTEXT        IDC_EDIT_CYCLES,115,69,42,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "TOS（0–255）：",IDC_STATIC,183,72,72,10
    EDITTEXT        IDC_EDIT_TOS,274,69,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "資料樣式（-1 為隨機）：",IDC_STATIC,18,96,100,10
    EDITTEXT        IDC_EDIT_PATTERN,120,93,42,14,ES_AUTOHSCROLL
    LTEXT           "歷程主機上限：",IDC_STATIC,183,96,72,10
    EDITTEXT        IDC_EDIT_MAX_LRU,274,93,50,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "解析主機名稱",IDC_CHECK_DNS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,115,78,10
    CONTROL         "查詢 ASN／ISP",IDC_CHECK_ASN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,115,80,10
    CONTROL         "禁止分段（DF）",IDC_CHECK_DF,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,207,115,80,10
    LTEXT           "位址家族：",IDC_STATIC,18,134,58,10
    CONTROL         "IPv4",IDC_CHECK_IPV4,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,82,133,42,10
    CONTROL         "IPv6",IDC_CHECK_IPV6,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,135,133,42,10
    GROUPBOX        "隱私與其他",IDC_STATIC,8,158,344,42
    CONTROL         "啟動時查詢目前公網 IP、地區與業者",IDC_CHECK_PUBLIC_INFO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,172,190,11
    PUSHBUTTON      "授權與貢獻者",ID_LICENSE,244,170,95,16,BS_FLAT
    PUSHBUTTON      "恢復預設",ID_RESTORE_DEFAULTS,77,213,70,17,BS_FLAT
    DEFPUSHBUTTON   "確定",IDOK,155,213,60,17,BS_FLAT
    PUSHBUTTON      "取消",IDCANCEL,223,213,60,17,BS_FLAT
END

