IDD_WINMTR_DIALOG DIALOGEX 0, 0, 560, 260
STYLE DS_SETFONT | DS_3DLOOK | DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
FONT 9, "Microsoft JhengHei UI", 0, 0, 0x1
BEGIN
    LTEXT           "主機：",IDC_STATIC,14,13,28,12,SS_CENTERIMAGE
    COMBOBOX        IDC_COMBO_HOST,43,11,210,90,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "開始(&S)",ID_RESTART,260,11,60,16,BS_FLAT
    PUSHBUTTON      "選項(&O)",ID_OPTIONS,326,11,60,16,BS_FLAT
    PUSHBUTTON      "網路資訊",ID_NETWORK_INFO,392,11,76,16,BS_FLAT
    PUSHBUTTON      "離開(&X)",IDCANCEL,475,11,70,16,BS_FLAT
    PUSHBUTTON      "複製文字",ID_CTTC,14,39,75,16,BS_FLAT
    PUSHBUTTON      "複製 HTML",ID_CHTC,95,39,80,16,BS_FLAT
    PUSHBUTTON      "重設統計",ID_RESET_STATS,181,39,70,16,BS_FLAT
    PUSHBUTTON      "匯出文字",ID_EXPT,284,39,62,16,BS_FLAT
    PUSHBUTTON      "匯出 HTML",ID_EXPH,351,39,62,16,BS_FLAT
    PUSHBUTTON      "匯出 CSV",ID_EXPC,418,39,62,16,BS_FLAT
    PUSHBUTTON      "匯出 JSON",ID_EXPJ,485,39,62,16,BS_FLAT
    CONTROL         "",IDC_LIST_MTR,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,63,546,190
    GROUPBOX        "",IDC_STATIC,7,3,246,30,BS_FLAT
    GROUPBOX        "",IDC_STATICS,257,3,296,30,BS_FLAT
    GROUPBOX        "",IDC_STATICJ,7,31,546,28,BS_FLAT
END

IDD_DIALOG_OPTIONS DIALOGEX 0, 0, 360, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "追蹤選項"
FONT 9, "Microsoft JhengHei UI", 0, 0, 0x0
BEGIN
    GROUPBOX        "探測設定",IDC_STATIC,8,7,344,126
    LTEXT           "間隔（秒）：",IDC_STATIC,18,24,58,10
    EDITTEXT        IDC_EDIT_INTERVAL,82,21,42,14,ES_AUTOHSCROLL
    LTEXT           "封包資料（位元組）：",IDC_STATIC,183,24,82,10
    EDITTEXT        IDC_EDIT_SIZE,274,21,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "最大跳數：",IDC_STATIC,18,48,58,10
    EDITTEXT        IDC_EDIT_MAX_HOPS,82,45,42,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "逾時（毫秒）：",IDC_STATIC,183,48,72,10
    EDITTEXT        IDC_EDIT_TIMEOUT,274,45,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "循環次數（0 為不限）：",IDC_STATIC,18,72,94,10
    EDITTEXT        IDC_EDIT_CYCLES,115,69,42,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "TOS（0–255）：",IDC_STATIC,183,72,72,10
    EDITTEXT        IDC_EDIT_TOS,274,69,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "資料樣式（-1 為隨機）：",IDC_STATIC,18,96,100,10
    EDITTEXT        IDC_EDIT_PATTERN,120,93,42,14,ES_AUTOHSCROLL
    LTEXT           "歷程主機上限：",IDC_STATIC,183,96,72,10
    EDITTEXT        IDC_EDIT_MAX_LRU,274,93,50,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "解析主機名稱",IDC_CHECK_DNS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,115,78,10
    CONTROL         "查詢 ASN／ISP",IDC_CHECK_ASN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,115,80,10
    CONTROL         "禁止分段（DF）",IDC_CHECK_DF,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,207,115,80,10
    GROUPBOX        "隱私與其他",IDC_STATIC,8,139,344,42
    CONTROL         "啟動時查詢目前公網 IP、地區與業者",IDC_CHECK_PUBLIC_INFO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,153,190,11
    PUSHBUTTON      "授權與貢獻者",ID_LICENSE,244,151,95,16,BS_FLAT
    DEFPUSHBUTTON   "確定",IDOK,111,193,60,17,BS_FLAT
    PUSHBUTTON      "取消",IDCANCEL,189,193,60,17,BS_FLAT
END

